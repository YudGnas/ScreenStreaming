<Window x:Class="ServerStreaming.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ServerStreaming"
        mc:Ignorable="d"
        Title="Screen Server" Height="600" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <WrapPanel x:Name="StreamsPanel" Orientation="Horizontal" Margin="5"/>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
            <Button Content="Start Recording" Width="100" Height="30" Margin="5"
            Click="StartRecording_Click"/>
            <Button Content="Stop Recording" Width="100" Height="30" Margin="5"
            Click="StopRecording_Click"/>
            <TextBlock x:Name="StatusText" Margin="10" Foreground="Black" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>

</Window>
