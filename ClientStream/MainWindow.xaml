<Window x:Class="ClientStream.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientStream"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Row 0: Preview -->
        <Border Grid.Row="0" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                Background="Black"
                Margin="0,0,0,0">
            <Image x:Name="PreviewImage" 
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
        <!-- Row 1: IP -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Server IP:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="ServerIpTextBox" Width="180" Text="127.0.0.1"/>
        </StackPanel>

        <!-- Row 2: Chọn nguồn Stream -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Nguồn:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="SourceComboBox" Width="150">
                <ComboBoxItem Content="Screen" IsSelected="True"/>
                <ComboBoxItem Content="Webcam"/>
            </ComboBox>
        </StackPanel>

        <!-- Row 3: Buttons -->
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,0,0,12">
            <Button x:Name="StartButton"
                Content="Start Streaming"
                Width="140"
                Height="32"
                Margin="0,0,12,0"
                Click="StartStreaming_Click"/>
            <Button x:Name="StopButton"
                Content="Stop Streaming"
                Width="140"
                Height="32"
                Margin="0,0,12,0"
                Click="StopStreaming_Click"/>
            <Button x:Name="MicToggleButton"
                Content="Mic: Off"
                Width="120"
                Height="32"
                Click="MicToggle_Click"/>
        </StackPanel>

        <!-- Row 4: Status -->
        <TextBlock x:Name="StatusText"
               Grid.Row="4"
               Foreground="DarkGreen"
               TextWrapping="Wrap"
               Text="Chưa kết nối."
               Margin="0,0,0,12"
        />
    </Grid>
</Window>